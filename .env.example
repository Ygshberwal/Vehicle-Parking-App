# Documentation only: the app does not auto-load this file.
# Enter these values privately in Render, or export them in your local shell.
APP_ENV=demo
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
SECURITY_PASSWORD_SALT=replace-with-a-different-random-value-at-least-32-characters
DEMO_PROFILE=large
